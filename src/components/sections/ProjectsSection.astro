---
import Prompt from '../Prompt.astro';
import type { Project } from '../../data/shellfolio';
const { projects, repoLinkText, promptCmd = "ls -l ~/Projects/", sectionId = "projects" } = Astro.props;
---
<section id={sectionId}>
  <Prompt cmd={promptCmd} />
  <div class="tui-list">
    {projects.map((proj: Project) => (
      <details class="tui-details">
        <summary class="list-item">
          <span class="indicator"></span>
          <span class="perms">{proj.perms}</span>
          <span class="file">{proj.file}</span>
        </summary>
        <div class="expanded-content prose">{proj.content}{proj.link && <><br /><br /><span class="text-muted">&gt;&gt; </span><a href={proj.link} target="_blank" rel="noopener noreferrer" class="hover-link" style="color: var(--text-muted); font-family: var(--font-prose); display: inline-block;">{repoLinkText}</a></>}</div>
      </details>
    ))}
  </div>
</section>
